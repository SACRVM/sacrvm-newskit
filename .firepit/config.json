{
  // Firepit per-project config. JSONC: comments and trailing commas are allowed.
  // Commands follow the Linux patterns of ../firepit-template/.firepit/config.json:
  // a group per area, a short lowercase name, a one-line description.

  "version": 1,
  "id": "sacrvm-newskit",

  "commands": [
    {
      "group": "Run",
      "name": "site",
      "description": "Serves the kit, style guide and demo on port 3001 (also reachable from a phone on the LAN).",
      "type": "shell",
      "command": "python3",
      "args": ["-m", "http.server", "3001"],
      "window": "reuse:site",
      "longRunning": true
    },

    {
      "group": "Open",
      "name": "demo",
      "description": "The demo article on the local server.",
      "type": "url",
      "url": "http://localhost:3001/demo/project-greek-island.html"
    },
    {
      "group": "Open",
      "name": "styleguide",
      "description": "The article primitives page of the style guide on the local server.",
      "type": "url",
      "url": "http://localhost:3001/styleguide/primitives.html"
    },
    {
      "group": "Open",
      "name": "plan",
      "description": "The project plan artifact on claude.ai.",
      "type": "url",
      "url": "https://claude.ai/code/artifact/44c9a845-c11a-40a9-ae5c-2fe7cc6495dc"
    },

    {
      "group": "Git",
      "name": "repo",
      "description": "The repository on GitHub.",
      "type": "url",
      "url": "https://github.com/SACRVM/sacrvm-newskit"
    }
  ]
}
